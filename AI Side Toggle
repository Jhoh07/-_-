using UnityEngine;
using UnityEngine.UI;

public class AISideToggle : MonoBehaviour
{
    public Toggle sideToggle;
    public ChessAI chessAI;

    [Tooltip("true면 토글 On=백(White), false면 토글 On=흑(Black)")]
    public bool onMeansWhite = true;

    void Start()
    {
        if (sideToggle == null || chessAI == null)
        {
            Debug.LogError("AISideToggle: sideToggle 또는 chessAI가 설정되지 않았습니다.");
            enabled = false;
            return;
        }

        sideToggle.isOn = onMeansWhite ? chessAI.aiPlaysWhite : !chessAI.aiPlaysWhite;
        sideToggle.onValueChanged.AddListener(OnToggleChanged);
    }

    void OnToggleChanged(bool isOn)
    {
        bool playsWhite = onMeansWhite ? isOn : !isOn;
        chessAI.SetAIPlaysWhite(playsWhite);
    }

    void OnDestroy()
    {
        if (sideToggle != null)
            sideToggle.onValueChanged.RemoveListener(OnToggleChanged);
    }
}
