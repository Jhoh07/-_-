using UnityEngine;
public class Bishop : ChessPiece
{
    public override ChessPieceType PieceType => ChessPieceType.Bishop;

    public override bool IsValidMove(int startX, int startY, int targetX, int targetY, GameObject[,] boardPieces)
    {
        int deltaX = Mathf.Abs(targetX - startX);
        int deltaY = Mathf.Abs(targetY - startY);
        if (deltaX != deltaY) return false;

        int xDir = (targetX > startX) ? 1 : -1;
        int yDir = (targetY > startY) ? 1 : -1;
        int checkX = startX + xDir;
        int checkY = startY + yDir;

        while (checkX != targetX && checkY != targetY)
        {
            if (boardPieces[checkX, checkY] != null) return false;
            checkX += xDir;
            checkY += yDir;
        }
        return true;
    }
}
