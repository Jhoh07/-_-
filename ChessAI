    private int GetHistoryBonus(bool isBlackMove, int startX, int startY, int targetX, int targetY)
    {
        int side = isBlackMove ? 1 : 0;
        return historyHeuristic[side, startX, startY, targetX, targetY];
    }

    private int GetKillerBonus(int ply, int startX, int startY, int targetX, int targetY)
    {
        int normalizedPly = Mathf.Clamp(ply, 0, MaxSearchPly - 1);

        KillerMove first = killerMoves[normalizedPly, 0];
        if (first.valid && first.startX == startX && first.startY == startY && first.targetX == targetX && first.targetY == targetY)
            return 3500;

        KillerMove second = killerMoves[normalizedPly, 1];
        if (second.valid && second.startX == startX && second.startY == startY && second.targetX == targetX && second.targetY == targetY)
            return 2500;

        return 0;
    }

    private void RegisterKiller(int ply, AIMove move)
    {
        int normalizedPly = Mathf.Clamp(ply, 0, MaxSearchPly - 1);

        KillerMove current = killerMoves[normalizedPly, 0];
        if (current.valid && current.startX == move.startX && current.startY == move.startY && current.targetX == move.targetX && current.targetY == move.targetY)
            return;

        killerMoves[normalizedPly, 1] = killerMoves[normalizedPly, 0];
        killerMoves[normalizedPly, 0] = new KillerMove
        {
            startX = move.startX,
            startY = move.startY,
            targetX = move.targetX,
            targetY = move.targetY,
            valid = true
        };
    }

    private void RegisterHistory(bool isBlackMove, AIMove move, int depth)
    {
        int side = isBlackMove ? 1 : 0;
        int bonus = depth * depth;
        int prev = historyHeuristic[side, move.startX, move.startY, move.targetX, move.targetY];
        historyHeuristic[side, move.startX, move.startY, move.targetX, move.targetY] = Mathf.Min(50000, prev + bonus);
    }

    private int GetMoveOrderingScore(GameObject piece, int startX, int startY, int targetX, int targetY, GameObject targetPiece, bool isBlackMove, int ply,
        bool ttMoveValid, int ttStartX, int ttStartY, int ttTargetX, int ttTargetY, bool? precomputedGivesCheck = null)
    {
        int score = 0;

        if (ttMoveValid && startX == ttStartX && startY == ttStartY && targetX == ttTargetX && targetY == ttTargetY)
            score += 25000;

        if (targetPiece != null)
            score += 10000 + (GetPieceValue(targetPiece) * 12) - GetPieceValue(piece);

        if (targetPiece == null)
        {
            score += GetKillerBonus(ply, startX, startY, targetX, targetY);
            score += GetHistoryBonus(isBlackMove, startX, startY, targetX, targetY);
        }

        bool shouldProbeCheck = targetPiece != null || ply == 0 || (!highPerformanceMode && ply <= 2);
        bool givesCheck = precomputedGivesCheck ?? (shouldProbeCheck && DoesMoveGiveCheck(piece, startX, startY, targetX, targetY, isBlackMove));

        if (givesCheck)
            score += 1500;

        score += GetCenterControlScore(targetX, targetY);
        return score;
    }

    private int EvaluatePawnStructure(bool isBlack)
    {
        int[] pawnFiles = new int[BoardSize];
        pawnBuffer.Clear();

        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                GameObject piece = boardManager.boardPieces[x, y];
                if (piece == null)
                    continue;

                bool sameColor = isBlack ? IsBlack(piece) : IsWhite(piece);
                if (!sameColor || !IsPieceType(piece, ChessPieceType.Pawn))
                    continue;

                pawnFiles[x]++;
                pawnBuffer.Add(new Vector2Int(x, y));
            }
        }

        int score = 0;

        for (int file = 0; file < BoardSize; file++)
        {
            if (pawnFiles[file] > 1)
                score -= (pawnFiles[file] - 1) * 4;
        }

        for (int i = 0; i < pawnBuffer.Count; i++)
        {
            int x = pawnBuffer[i].x;
            int y = pawnBuffer[i].y;

            bool hasLeftSupport = x > 0 && pawnFiles[x - 1] > 0;
            bool hasRightSupport = x < BoardSize - 1 && pawnFiles[x + 1] > 0;
            if (!hasLeftSupport && !hasRightSupport)
                score -= 3;

            if (IsPassedPawn(isBlack, x, y))
            {
                int progress = isBlack ? (BoardSize - 1 - y) : y;
                score += 4 + progress * 2;
            }
        }

        return score;
    }

    private bool IsPassedPawn(bool isBlack, int pawnX, int pawnY)
    {
        for (int ex = pawnX - 1; ex <= pawnX + 1; ex++)
        {
            if (ex < 0 || ex >= BoardSize)
                continue;

            if (isBlack)
            {
                for (int ey = pawnY - 1; ey >= 0; ey--)
                {
                    GameObject enemy = boardManager.boardPieces[ex, ey];
                    if (IsPieceType(enemy, ChessPieceType.Pawn) && IsWhite(enemy))
                        return false;
                }
            }
            else
            {
                for (int ey = pawnY + 1; ey < BoardSize; ey++)
                {
                    GameObject enemy = boardManager.boardPieces[ex, ey];
                    if (IsPieceType(enemy, ChessPieceType.Pawn) && IsBlack(enemy))
                        return false;
                }
            }
        }

        return true;
    }

    private bool TryFindKing(bool isBlack, out int kingX, out int kingY)
    {
        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                GameObject piece = boardManager.boardPieces[x, y];
                if (!IsPieceType(piece, ChessPieceType.King))
                    continue;

                bool sameColor = isBlack ? IsBlack(piece) : IsWhite(piece);
                if (!sameColor)
                    continue;

                kingX = x;
                kingY = y;
                return true;
            }
        }

        kingX = -1;
        kingY = -1;
        return false;
    }

    private bool IsSquareAttackedByRule(int targetX, int targetY, bool byWhite)
    {
        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                GameObject attacker = boardManager.boardPieces[x, y];
                if (attacker == null)
                    continue;

                bool sameSide = byWhite ? IsWhite(attacker) : IsBlack(attacker);
                if (!sameSide)
                    continue;

                if (boardManager.IsRuleValidMove(attacker, x, y, targetX, targetY))
                    return true;
            }
        }

        return false;
    }

    private int EvaluateKingSafety(bool isBlack)
    {
        if (!TryFindKing(isBlack, out int kingX, out int kingY))
            return 0;

        int score = 0;
        int attackers = 0;

        for (int dx = -1; dx <= 1; dx++)
        {
            for (int dy = -1; dy <= 1; dy++)
            {
                int nx = kingX + dx;
                int ny = kingY + dy;
                if (nx < 0 || nx >= BoardSize || ny < 0 || ny >= BoardSize)
                    continue;

                if (IsSquareAttackedByRule(nx, ny, byWhite: isBlack ? true : false))
                    attackers++;
            }
        }

        score -= attackers * 3;

        int pawnShieldY = isBlack ? kingY - 1 : kingY + 1;
        if (pawnShieldY >= 0 && pawnShieldY < BoardSize)
        {
            for (int sx = kingX - 1; sx <= kingX + 1; sx++)
            {
                if (sx < 0 || sx >= BoardSize)
                    continue;

                GameObject shield = boardManager.boardPieces[sx, pawnShieldY];
                if (!IsPieceType(shield, ChessPieceType.Pawn))
                    continue;

                bool sameColor = isBlack ? IsBlack(shield) : IsWhite(shield);
                if (sameColor)
                    score += 2;
            }
        }

        return score;
    }

    private int EvaluateKingActivityInEndgame(bool isBlack, float endgameT)
    {
        if (endgameT <= 0.01f)
            return 0;

        if (!TryFindKing(isBlack, out int kingX, out int kingY))
            return 0;

        int center = GetCenterControlScore(kingX, kingY);
        return Mathf.RoundToInt(center * endgameT * 2.5f);
    }

    private bool AttacksSquareByType(GameObject piece, int startX, int startY, int targetX, int targetY)
    {
        ChessPiece chessPiece = GetChessPiece(piece);
        if (chessPiece == null)
            return false;

        int deltaX = targetX - startX;
        int deltaY = targetY - startY;
        if (deltaX == 0 && deltaY == 0)
            return false;

        switch (chessPiece.PieceType)
        {
            case ChessPieceType.Pawn:
                return deltaY == (chessPiece.isWhite ? 1 : -1) && Mathf.Abs(deltaX) == 1;
            case ChessPieceType.Knight:
                return (Mathf.Abs(deltaX) == 1 && Mathf.Abs(deltaY) == 2) || (Mathf.Abs(deltaX) == 2 && Mathf.Abs(deltaY) == 1);
            case ChessPieceType.Bishop:
                if (Mathf.Abs(deltaX) != Mathf.Abs(deltaY))
                    return false;
                return IsPathClearOnBoard(startX, startY, targetX, targetY);
            case ChessPieceType.Rook:
                if (deltaX != 0 && deltaY != 0)
                    return false;
                return IsPathClearOnBoard(startX, startY, targetX, targetY);
            case ChessPieceType.Queen:
                if (deltaX == 0 || deltaY == 0 || Mathf.Abs(deltaX) == Mathf.Abs(deltaY))
                    return IsPathClearOnBoard(startX, startY, targetX, targetY);
                return false;
            case ChessPieceType.King:
                return Mathf.Abs(deltaX) <= 1 && Mathf.Abs(deltaY) <= 1;
            default:
                return false;
        }
    }

    private bool IsPathClearOnBoard(int startX, int startY, int targetX, int targetY)
    {
        int stepX = Math.Sign(targetX - startX);
        int stepY = Math.Sign(targetY - startY);
        int x = startX + stepX;
        int y = startY + stepY;

        while (x != targetX || y != targetY)
        {
            if (boardManager.boardPieces[x, y] != null)
                return false;

            x += stepX;
            y += stepY;
        }

        return true;
    }

    private int CountAttackersOnBoard(int targetX, int targetY, bool byBlack, out int lowestAttackerValue)
    {
        int count = 0;
        lowestAttackerValue = int.MaxValue;

        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                GameObject attacker = boardManager.boardPieces[x, y];
                if (attacker == null)
                    continue;

                bool sameSide = byBlack ? IsBlack(attacker) : IsWhite(attacker);
                if (!sameSide)
                    continue;

                if (!AttacksSquareByType(attacker, x, y, targetX, targetY))
                    continue;

                count++;
                int value = GetPieceValue(attacker);
                if (value < lowestAttackerValue)
                    lowestAttackerValue = value;
            }
        }

        if (count == 0)
            lowestAttackerValue = 0;

        return count;
    }

    private int CountDefendersOnBoard(int targetX, int targetY, bool byBlack, int excludeX, int excludeY)
    {
        int count = 0;

        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                if (x == excludeX && y == excludeY)
                    continue;

                GameObject defender = boardManager.boardPieces[x, y];
                if (defender == null)
                    continue;

                bool sameSide = byBlack ? IsBlack(defender) : IsWhite(defender);
                if (!sameSide)
                    continue;

                if (AttacksSquareByType(defender, x, y, targetX, targetY))
                    count++;
            }
        }

        return count;
    }

    private int EvaluatePieceSafety(bool isBlack, float endgameT)
    {
        int score = 0;
        float endgameFactor = Mathf.Lerp(1f, 1f - PieceSafetyEndgameFade, Mathf.Clamp01(endgameT));

        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                GameObject piece = boardManager.boardPieces[x, y];
                if (piece == null || IsPieceType(piece, ChessPieceType.King))
                    continue;

                bool sameSide = isBlack ? IsBlack(piece) : IsWhite(piece);
                if (!sameSide)
                    continue;

                int pieceValue = GetPieceValue(piece);
                int attackers = CountAttackersOnBoard(x, y, byBlack: !isBlack, out int lowestAttackerValue);
                if (attackers == 0)
                    continue;

                int defenders = CountDefendersOnBoard(x, y, byBlack: isBlack, excludeX: x, excludeY: y);
                int imbalance = Mathf.Max(0, attackers - defenders);

                int penalty = imbalance * Mathf.Max(2, pieceValue / 6);
                if (defenders == 0)
                    penalty += Mathf.RoundToInt(Mathf.Max(2, pieceValue / 4) * UndefendedPenaltyBoost);

                if (lowestAttackerValue > 0 && lowestAttackerValue < pieceValue)
                    penalty += Mathf.Max(1, (pieceValue - lowestAttackerValue) / 5);

                penalty = Mathf.RoundToInt(penalty * PieceSafetyGlobalWeight * endgameFactor);

                score -= penalty;
            }
        }

        return score;
    }

    private int EvaluateMovedPieceExposureSignal(GameObject movedPiece, int targetX, int targetY, bool movedIsBlack, int capturedValue)
    {
        if (movedPiece == null)
            return capturedValue;

        int pieceValue = GetPieceValue(movedPiece);
        if (pieceValue <= 0)
            return capturedValue;

        int attackers = CountAttackersOnBoard(targetX, targetY, byBlack: !movedIsBlack, out int lowestAttackerValue);
        if (attackers == 0)
            return capturedValue;

        int defenders = CountDefendersOnBoard(targetX, targetY, byBlack: movedIsBlack, excludeX: targetX, excludeY: targetY);
        int imbalance = Mathf.Max(0, attackers - defenders);

        int penalty = imbalance * Mathf.Max(2, pieceValue / 6);
        if (defenders == 0)
            penalty += Mathf.RoundToInt(Mathf.Max(2, pieceValue / 4) * UndefendedPenaltyBoost);

        if (lowestAttackerValue > 0 && lowestAttackerValue < pieceValue)
            penalty += Mathf.Max(1, (pieceValue - lowestAttackerValue) / 5);

        return capturedValue - penalty;
    }

    private bool ShouldExtendForExposureTrade(int depth, int ply, int tacticalSignal, int movedPieceValue, bool isCapture)
    {
        if (depth <= 1 || ply >= TacticalExtensionMaxPly)
            return false;

        int riskThreshold = Mathf.Max(6, movedPieceValue / 5);
        int gainThreshold = Mathf.Max(8, movedPieceValue / 6);

        bool severeRisk = tacticalSignal <= -riskThreshold;
        bool meaningfulCompensation = tacticalSignal >= gainThreshold;
        bool speculativeSacrifice = !isCapture && tacticalSignal <= -Mathf.Max(8, movedPieceValue / 4);

        return severeRisk || meaningfulCompensation || speculativeSacrifice;
    }

    private ulong ComputeBoardHash(bool whiteToMove)
    {
        unchecked
        {
            ulong hash = 1469598103934665603UL;

            for (int x = 0; x < BoardSize; x++)
            {
                for (int y = 0; y < BoardSize; y++)
                {
                    GameObject piece = boardManager.boardPieces[x, y];
                    if (piece == null)
                        continue;

                    ulong cell = (ulong)(x * BoardSize + y + 1);
                    hash ^= cell;
                    hash *= 1099511628211UL;

                    ChessPiece cp = GetChessPiece(piece);
                    bool isWhitePiece = cp != null && cp.isWhite;
                    bool hasMoved = cp != null && cp.hasMoved;
                    int pieceType = GetPieceTypeIndex(piece);

                    ulong pieceCode = (ulong)(pieceType + (isWhitePiece ? 8 : 16) + (hasMoved ? 32 : 0));
                    hash ^= pieceCode;
                    hash *= 1099511628211UL;
                }
            }

            hash ^= whiteToMove ? 1UL : 2UL;
            hash *= 1099511628211UL;
            return hash;
        }
    }

    private void StoreTransposition(ulong hash, TTEntry candidate)
    {
        if (transpositionTable.TryGetValue(hash, out TTEntry existing))
        {
            bool replace = false;
            if (candidate.depth > existing.depth)
                replace = true;
            else if (candidate.depth == existing.depth && candidate.age >= existing.age)
                replace = true;
            else if (candidate.flag == TTFlag.Exact && existing.flag != TTFlag.Exact)
                replace = true;

            if (replace)
                transpositionTable[hash] = candidate;

            return;
        }

        if (transpositionTable.Count >= MaxTranspositionEntries)
            PruneTranspositionTable();

        if (transpositionTable.Count < MaxTranspositionEntries)
            transpositionTable[hash] = candidate;
    }

    private void PruneTranspositionTable()
    {
        transpositionPruneBuffer.Clear();

        foreach (KeyValuePair<ulong, TTEntry> kv in transpositionTable)
        {
            if (searchGeneration - kv.Value.age > TranspositionKeepGenerations)
                transpositionPruneBuffer.Add(kv.Key);
        }

        for (int i = 0; i < transpositionPruneBuffer.Count; i++)
            transpositionTable.Remove(transpositionPruneBuffer[i]);

        if (transpositionTable.Count >= MaxTranspositionEntries)
            transpositionTable.Clear();
    }

    private bool DoesMoveGiveCheck(GameObject piece, int startX, int startY, int targetX, int targetY, bool isBlackMove)
    {
        ApplyTemporaryMove(piece, startX, startY, targetX, targetY, out GameObject capturedPiece);
        bool givesCheck = boardManager.IsKingInCheck(!isBlackMove);
        RevertTemporaryMove(piece, startX, startY, targetX, targetY, capturedPiece);
        return givesCheck;
    }

    private int QuiescenceSearch(int alpha, int beta, bool whiteToMove, int depth)
    {
        if (searchAborted || Time.realtimeSinceStartup >= searchDeadline)
        {
            searchAborted = true;
            return EvaluateBoard();
        }

        int standPat = EvaluateBoard();

        if (depth <= 0)
            return standPat;

        if (!whiteToMove)
        {
            if (standPat >= beta)
                return standPat;

            if (standPat > alpha)
                alpha = standPat;

            List<AIMove> captures = RentAIMoveList();
            try
            {
                CollectMoves(captures, isBlack: true, ply: 0, capturesOnly: true, includeCheckingMoves: true);
                int moveLimit = highPerformanceMode ? Mathf.Min(MaxQuiescenceMoves, captures.Count) : captures.Count;
                for (int i = 0; i < moveLimit; i++)
                {
                    AIMove move = captures[i];
                    GameObject captured;
                    ApplyTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, out captured);
                    int score = QuiescenceSearch(alpha, beta, true, depth - 1);
                    RevertTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, captured);

                    if (searchAborted)
                        return alpha;

                    if (score > alpha)
                        alpha = score;

                    if (alpha >= beta)
                        break;
                }

                return alpha;
            }
            finally
            {
                ReturnAIMoveList(captures);
            }
        }

        if (standPat <= alpha)
            return standPat;

        if (standPat < beta)
            beta = standPat;

        List<AIMove> whiteCaptures = RentAIMoveList();
        try
        {
            CollectMoves(whiteCaptures, isBlack: false, ply: 0, capturesOnly: true, includeCheckingMoves: true);
            int whiteMoveLimit = highPerformanceMode ? Mathf.Min(MaxQuiescenceMoves, whiteCaptures.Count) : whiteCaptures.Count;
            for (int i = 0; i < whiteMoveLimit; i++)
            {
                AIMove move = whiteCaptures[i];
                GameObject captured;
                ApplyTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, out captured);
                int score = QuiescenceSearch(alpha, beta, false, depth - 1);
                RevertTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, captured);

                if (searchAborted)
                    return beta;

                if (score < beta)
                    beta = score;

                if (beta <= alpha)
                    break;
            }

            return beta;
        }
        finally
        {
            ReturnAIMoveList(whiteCaptures);
        }
    }

    private int Minimax(int depth, int alpha, int beta, bool whiteToMove, int ply, bool allowNullMove)
    {
        if (searchAborted || Time.realtimeSinceStartup >= searchDeadline)
        {
            searchAborted = true;
            return EvaluateBoard();
        }

        bool sideInCheck = boardManager.IsKingInCheck(whiteToMove);

        int alphaOriginal = alpha;
        int betaOriginal = beta;
        ulong hash = ComputeBoardHash(whiteToMove);
        bool ttMoveValid = false;
        int ttStartX = -1;
        int ttStartY = -1;
        int ttTargetX = -1;
        int ttTargetY = -1;

        if (transpositionTable.TryGetValue(hash, out TTEntry entry) && entry.depth >= depth)
        {
            if (entry.flag == TTFlag.Exact)
                return entry.score;

            if (entry.hasBestMove)
            {
                ttMoveValid = true;
                ttStartX = entry.bestStartX;
                ttStartY = entry.bestStartY;
                ttTargetX = entry.bestTargetX;
                ttTargetY = entry.bestTargetY;
            }

            if (entry.flag == TTFlag.LowerBound)
                alpha = Mathf.Max(alpha, entry.score);
            else
                beta = Mathf.Min(beta, entry.score);

            if (alpha >= beta)
                return entry.score;
        }

        if (depth <= 0)
        {
            if (!sideInCheck || ply >= MaxSearchPly - 2)
                return QuiescenceSearch(alpha, beta, whiteToMove, MaxQuiescenceDepth);

            depth = 1;
        }

        // Null-move pruning helps cut branches where passing still keeps a good enough position.
        if (allowNullMove && depth >= 3 && !sideInCheck && HasNonPawnMaterial(whiteToMove))
        {
            if (!whiteToMove)
            {
                int nullScore = Minimax(depth - 1 - NullMoveReduction, alpha, beta, true, ply + 1, false);
                if (!searchAborted && nullScore >= beta)
                    return nullScore;
            }
            else
            {
                int nullScore = Minimax(depth - 1 - NullMoveReduction, alpha, beta, false, ply + 1, false);
                if (!searchAborted && nullScore <= alpha)
                    return nullScore;
            }
        }

        List<AIMove> legalMoves = RentAIMoveList();
        try
        {
            CollectMoves(legalMoves, isBlack: !whiteToMove, ply: ply, capturesOnly: false,
                ttMoveValid: ttMoveValid, ttStartX: ttStartX, ttStartY: ttStartY, ttTargetX: ttTargetX, ttTargetY: ttTargetY);

            if (legalMoves.Count == 0)
            {
                if (boardManager.IsKingInCheck(whiteToMove))
                    return whiteToMove ? MateScore : -MateScore;

                return 0;
            }

            int bestScore;
            AIMove bestMove = default;
            bool hasBestMove = false;

            if (!whiteToMove)
            {
                bestScore = int.MinValue;
                bool isBlackMove = true;
                bool exploredAny = false;

                for (int moveIndex = 0; moveIndex < legalMoves.Count; moveIndex++)
                {
                    AIMove move = legalMoves[moveIndex];
                    GameObject captured;
                    ApplyTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, out captured);

                    int nextDepth = depth - 1;
                    bool isQuietMove = captured == null;
                    GameObject movedPieceAfter = boardManager.boardPieces[move.targetX, move.targetY];
                    int movedPieceValue = GetPieceValue(movedPieceAfter);
                    int tacticalSignal = EvaluateMovedPieceExposureSignal(movedPieceAfter, move.targetX, move.targetY, movedIsBlack: true, capturedValue: GetPieceValue(captured));
                    bool shouldExtend = ShouldExtendForExposureTrade(depth, ply, tacticalSignal, movedPieceValue, isCapture: !isQuietMove);

                    bool canReduce = depth >= 3 && moveIndex >= 3 && isQuietMove && !sideInCheck && !shouldExtend;
                    if (canReduce)
                        nextDepth = depth - 2;

                    if (shouldExtend && (!highPerformanceMode || !isQuietMove))
                        nextDepth = Mathf.Max(nextDepth, depth);

                    int score = Minimax(nextDepth, alpha, beta, true, ply + 1, true);
                    if (canReduce && !searchAborted && score > alpha)
                        score = Minimax(depth - 1, alpha, beta, true, ply + 1, true);

                    RevertTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, captured);

                    if (searchAborted)
                        return exploredAny ? bestScore : EvaluateBoard();

                    exploredAny = true;

                    if (score > bestScore)
                    {
                        bestScore = score;
                        bestMove = move;
                        hasBestMove = true;
                    }

                    if (bestScore > alpha)
                        alpha = bestScore;

                    if (beta <= alpha)
                    {
                        if (captured == null)
                        {
                            RegisterKiller(ply, move);
                            RegisterHistory(isBlackMove, move, depth);
                        }
                        break;
                    }
                }
            }
            else
            {
                bestScore = int.MaxValue;
                bool isBlackMove = false;
                bool exploredAny = false;

                for (int moveIndex = 0; moveIndex < legalMoves.Count; moveIndex++)
                {
                    AIMove move = legalMoves[moveIndex];
                    GameObject captured;
                    ApplyTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, out captured);

                    int nextDepth = depth - 1;
                    bool isQuietMove = captured == null;
                    GameObject movedPieceAfter = boardManager.boardPieces[move.targetX, move.targetY];
                    int movedPieceValue = GetPieceValue(movedPieceAfter);
                    int tacticalSignal = EvaluateMovedPieceExposureSignal(movedPieceAfter, move.targetX, move.targetY, movedIsBlack: false, capturedValue: GetPieceValue(captured));
                    bool shouldExtend = ShouldExtendForExposureTrade(depth, ply, tacticalSignal, movedPieceValue, isCapture: !isQuietMove);

                    bool canReduce = depth >= 3 && moveIndex >= 3 && isQuietMove && !sideInCheck && !shouldExtend;
                    if (canReduce)
                        nextDepth = depth - 2;

                    if (shouldExtend && (!highPerformanceMode || !isQuietMove))
                        nextDepth = Mathf.Max(nextDepth, depth);

                    int score = Minimax(nextDepth, alpha, beta, false, ply + 1, true);
                    if (canReduce && !searchAborted && score < beta)
                        score = Minimax(depth - 1, alpha, beta, false, ply + 1, true);

                    RevertTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, captured);

                    if (searchAborted)
                        return exploredAny ? bestScore : EvaluateBoard();

                    exploredAny = true;

                    if (score < bestScore)
                    {
                        bestScore = score;
                        bestMove = move;
                        hasBestMove = true;
                    }

                    if (bestScore < beta)
                        beta = bestScore;

                    if (beta <= alpha)
                    {
                        if (captured == null)
                        {
                            RegisterKiller(ply, move);
                            RegisterHistory(isBlackMove, move, depth);
                        }
                        break;
                    }
                }
            }

            TTFlag flag = TTFlag.Exact;
            if (bestScore <= alphaOriginal)
                flag = TTFlag.UpperBound;
            else if (bestScore >= betaOriginal)
                flag = TTFlag.LowerBound;

            StoreTransposition(hash, new TTEntry
            {
                depth = depth,
                score = bestScore,
                flag = flag,
                age = searchGeneration,
                hasBestMove = hasBestMove,
                bestStartX = bestMove.startX,
                bestStartY = bestMove.startY,
                bestTargetX = bestMove.targetX,
                bestTargetY = bestMove.targetY
            });

            return bestScore;
        }
        finally
        {
            ReturnAIMoveList(legalMoves);
        }
    }

    private void ApplyTemporaryMove(GameObject piece, int startX, int startY, int targetX, int targetY, out GameObject capturedPiece)
    {
        capturedPiece = boardManager.boardPieces[targetX, targetY];
        boardManager.boardPieces[targetX, targetY] = piece;
        boardManager.boardPieces[startX, startY] = null;
    }

    private void RevertTemporaryMove(GameObject piece, int startX, int startY, int targetX, int targetY, GameObject capturedPiece)
    {
        boardManager.boardPieces[startX, startY] = piece;
        boardManager.boardPieces[targetX, targetY] = capturedPiece;
    }

    private void MakeAIMove()
    {
        bool aiPlaysBlack = !aiPlaysWhite;
        bool maximizingRoot = aiPlaysBlack;

        if (TryPlayOpeningBookMove())
            return;

        searchGeneration++;
        if (searchGeneration > 1000000)
            searchGeneration = 1;

        if (transpositionTable.Count >= MaxTranspositionEntries)
            PruneTranspositionTable();

        searchAborted = false;
        searchDeadline = forceFullDepthSearch
            ? float.PositiveInfinity
            : Time.realtimeSinceStartup + Mathf.Max(0.05f, thinkTimeSeconds);

        List<AIMove> possibleMoves = RentAIMoveList();
        List<AIMove> bestMoves = RentAIMoveList();
        List<AIMove> depthBestMoves = RentAIMoveList();

        try
        {
            CollectMoves(possibleMoves, isBlack: aiPlaysBlack, ply: 0);
            if (possibleMoves.Count == 0) return;

            int depthLimit = Mathf.Clamp(searchDepth, 1, 20);
            bestMoves.AddRange(possibleMoves);
            int bestScore = maximizingRoot ? int.MinValue : int.MaxValue;
            bool hasStableBest = false;
            int previousIterationScore = 0;

            for (int currentDepth = 1; currentDepth <= depthLimit; currentDepth++)
            {
                if (Time.realtimeSinceStartup >= searchDeadline)
                    break;

                int depthBestScore = maximizingRoot ? int.MinValue : int.MaxValue;
                depthBestMoves.Clear();

                int alpha = currentDepth == 1 ? int.MinValue + 1 : previousIterationScore - AspirationWindow;
                int beta = currentDepth == 1 ? int.MaxValue - 1 : previousIterationScore + AspirationWindow;

                for (int i = 0; i < possibleMoves.Count; i++)
                {
                    if (Time.realtimeSinceStartup >= searchDeadline)
                    {
                        searchAborted = true;
                        break;
                    }

                    AIMove move = possibleMoves[i];
                    GameObject captured;
                    ApplyTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, out captured);
                    int score = Minimax(currentDepth - 1, alpha, beta, !aiPlaysWhite, 1, true);

                    if (!searchAborted && (score <= alpha || score >= beta))
                        score = Minimax(currentDepth - 1, int.MinValue + 1, int.MaxValue - 1, !aiPlaysWhite, 1, true);

                    RevertTemporaryMove(move.piece, move.startX, move.startY, move.targetX, move.targetY, captured);

                    if (searchAborted)
                        break;

                    move.score = score;
                    possibleMoves[i] = move;

                    bool isBetter = maximizingRoot ? score > depthBestScore : score < depthBestScore;
                    if (isBetter)
                    {
                        depthBestScore = score;
                        depthBestMoves.Clear();
                        depthBestMoves.Add(move);
                    }
                    else if (score == depthBestScore)
                    {
                        depthBestMoves.Add(move);
                    }
                }

                if (!searchAborted && depthBestMoves.Count > 0)
                {
                    bestScore = depthBestScore;
                    hasStableBest = true;
                    previousIterationScore = depthBestScore;
                    bestMoves.Clear();
                    bestMoves.AddRange(depthBestMoves);

                    possibleMoves.Sort((a, b) => b.score.CompareTo(a.score));
                }

                if (searchAborted)
                    break;
            }

            if (bestMoves.Count == 0)
            {
                if (possibleMoves.Count == 0)
                {
                    UnityEngine.Debug.LogWarning("AI가 선택 가능한 수를 찾지 못해 턴을 종료합니다.");
                    return;
                }

                bestMoves.Add(possibleMoves[0]);
            }

            int chosenIndex = bestMoves.Count == 1 ? 0 : Random.Range(0, bestMoves.Count);
            AIMove chosenMove = bestMoves[chosenIndex];
            chosenMove.score = hasStableBest ? bestScore : chosenMove.score;

            int aiScore = NormalizeScoreForSide(chosenMove.score, aiPlaysBlack);

            if (aiScore > 0)
                UnityEngine.Debug.Log($"🤖 AI: 이득이 큽니다! ({aiScore}점짜리 안전한 공격을 실행합니다.)");
            else if (aiScore < 0)
                UnityEngine.Debug.Log($"🤖 AI: 모든 곳이 위험합니다. 어쩔 수 없이 희생합니다... (점수: {aiScore})");
            else
                UnityEngine.Debug.Log("🤖 AI: 조심스럽게 안전한 곳으로 이동합니다.");

            boardManager.ExecuteMove(chosenMove.piece, chosenMove.startX, chosenMove.startY, chosenMove.targetX, chosenMove.targetY);
            if (aiPlaysBlack)
                blackBookPly++;
        }
        finally
        {
            ReturnAIMoveList(depthBestMoves);
            ReturnAIMoveList(bestMoves);
            ReturnAIMoveList(possibleMoves);
        }
    }

    private bool TryPlayOpeningBookMove()
    {
        if (aiPlaysWhite)
            return false;

        if (blackBookPly > 1)
            return false;

        List<BookMove> candidates = RentBookMoveList();
        try
        {
            GetOpeningCandidatesForCurrentBoard(candidates);
            for (int i = 0; i < candidates.Count; i++)
            {
                BookMove book = candidates[i];
                GameObject piece = boardManager.boardPieces[book.startX, book.startY];
                if (piece == null || !IsBlack(piece))
                    continue;

                if (!boardManager.IsValidMove(piece, book.startX, book.startY, book.targetX, book.targetY))
                    continue;

                UnityEngine.Debug.Log("🤖 AI 북 수 선택: 초반 정석 전개를 사용합니다.");
                boardManager.ExecuteMove(piece, book.startX, book.startY, book.targetX, book.targetY);
                blackBookPly++;
                return true;
            }

            return false;
        }
        finally
        {
            ReturnBookMoveList(candidates);
        }
    }

    private void LoadOpeningBook()
    {
        TextAsset openingBookJson = Resources.Load<TextAsset>("opening_book_black");
        if (openingBookJson == null)
        {
            UnityEngine.Debug.LogWarning("opening_book_black.json을 찾지 못해 내장 기본 오프닝 북을 사용합니다.");
            openingBook = BuildFallbackOpeningBook();
            return;
        }

        try
        {
            openingBook = JsonUtility.FromJson<OpeningBookData>(openingBookJson.text);
            if (openingBook == null || openingBook.rules == null || openingBook.rules.Count == 0)
            {
                UnityEngine.Debug.LogWarning("오프닝 북 JSON이 비어 있어 내장 기본 오프닝 북을 사용합니다.");
                openingBook = BuildFallbackOpeningBook();
            }
        }
        catch (Exception ex)
        {
            UnityEngine.Debug.LogWarning($"오프닝 북 JSON 파싱 실패: {ex.Message}. 내장 기본 오프닝 북을 사용합니다.");
            openingBook = BuildFallbackOpeningBook();
        }
    }

