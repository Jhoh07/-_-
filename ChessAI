    void Start()
    {
        boardManager = GetComponent<ChessBoardManager>();
        if (boardManager == null)
            UnityEngine.Debug.LogError("ChessBoardManager가 없습니다!");
    }

    void Update()
    {
        if (boardManager == null || boardManager.isGameOver || !aiEnabled)
            return;

        if (boardManager.isWhiteTurn != aiPlaysWhite)
        {
            aiTimer = 0f;
            return;
        }

        if (activeSearchTask != null)
        {
            if (activeSearchTask.IsCompleted)
                FinishBackgroundSearch();

            return;
        }

        StartBackgroundSearch();
    }

    private void StartBackgroundSearch()
    {
        if (boardManager == null || boardManager.isGameOver || !aiEnabled || activeSearchTask != null)
            return;

        if (TryPlayOpeningBookMove())
            return;

        BoardSnapshot snapshot = CreateBoardSnapshot();
        bool aiPlaysBlack = !aiPlaysWhite;
        int depthLimit = Mathf.Clamp(searchDepth, 1, 20);
        float deadlineSeconds = forceFullDepthSearch ? float.PositiveInfinity : Mathf.Max(0.05f, thinkTimeSeconds);

        activeSearchTask = Task.Run(() => SearchBestMoveSnapshot(snapshot, aiPlaysBlack, depthLimit, deadlineSeconds));
    }

    private void FinishBackgroundSearch()
    {
        if (activeSearchTask == null || !activeSearchTask.IsCompleted)
            return;

        try
        {
            SnapshotSearchResult result = activeSearchTask.Result;
            if (result.hasMove && boardManager != null && !boardManager.isGameOver && boardManager.isWhiteTurn == aiPlaysWhite)
            {
                GameObject piece = boardManager.boardPieces[result.startX, result.startY];
                if (piece != null)
                    boardManager.ExecuteMove(piece, result.startX, result.startY, result.targetX, result.targetY);
            }
        }
        catch (Exception ex)
        {
            UnityEngine.Debug.LogWarning($"AI 백그라운드 탐색 실패: {ex.Message}");
        }
        finally
        {
            activeSearchTask = null;
        }
    }

