    private static ChessPiece GetChessPiece(GameObject piece)
    {
        return piece != null ? piece.GetComponent<ChessPiece>() : null;
    }

    private static bool IsWhite(GameObject piece)
    {
        ChessPiece chessPiece = GetChessPiece(piece);
        return chessPiece != null && chessPiece.isWhite;
    }

    private static bool IsBlack(GameObject piece)
    {
        ChessPiece chessPiece = GetChessPiece(piece);
        return chessPiece != null && !chessPiece.isWhite;
    }

    private static bool IsPieceType(GameObject piece, ChessPieceType pieceType)
    {
        ChessPiece chessPiece = GetChessPiece(piece);
        return chessPiece != null && chessPiece.PieceType == pieceType;
    }

    private static int NormalizeScoreForSide(int rawScore, bool sideIsBlack)
    {
        return sideIsBlack ? rawScore : -rawScore;
    }

    private int GetPieceValue(GameObject piece)
    {
        ChessPiece chessPiece = GetChessPiece(piece);
        if (chessPiece == null)
            return 0;

        switch (chessPiece.PieceType)
        {
            case ChessPieceType.Pawn: return 10;
            case ChessPieceType.Knight: return 30;
            case ChessPieceType.Bishop: return 30;
            case ChessPieceType.Rook: return 50;
            case ChessPieceType.Queen: return 90;
            case ChessPieceType.King: return 900;
        }

        return 0;
    }

    private int GetCenterControlScore(int x, int y)
    {
        int distance = Mathf.Abs(x - 3) + Mathf.Abs(y - 3);
        return Mathf.Max(0, 4 - distance) * 2;
    }

    private int GetPositionalScore(GameObject piece, int x, int y)
    {
        ChessPiece chessPiece = GetChessPiece(piece);
        if (chessPiece == null)
            return 0;

        int bonus = GetCenterControlScore(x, y);

        switch (chessPiece.PieceType)
        {
            case ChessPieceType.Pawn: return bonus + 5;
            case ChessPieceType.Knight: return bonus + 10;
            case ChessPieceType.Bishop: return bonus + 8;
            case ChessPieceType.Rook: return bonus + 6;
            case ChessPieceType.Queen: return bonus + 4;
            case ChessPieceType.King: return -Mathf.Abs(x - 3) - Mathf.Abs(y - 3);
        }

        return 0;
    }

    private int EvaluateBoard()
    {
        int total = 0;
        int nonKingMaterial = 0;

        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                GameObject piece = boardManager.boardPieces[x, y];
                if (piece == null)
                    continue;

                int value = GetPieceValue(piece) + GetPositionalScore(piece, x, y);
                total += IsBlack(piece) ? value : -value;

                if (!IsPieceType(piece, ChessPieceType.King))
                    nonKingMaterial += GetPieceValue(piece);
            }
        }

        total += EvaluatePawnStructure(isBlack: true);
        total -= EvaluatePawnStructure(isBlack: false);

        float endgameT = Mathf.Clamp01(1f - (nonKingMaterial / 780f));

        total += EvaluateKingSafety(isBlack: true);
        total -= EvaluateKingSafety(isBlack: false);
        total += EvaluatePieceSafety(isBlack: true, endgameT);
        total -= EvaluatePieceSafety(isBlack: false, endgameT);

        if (!highPerformanceMode)
        {
            total += EvaluateMobility(isBlack: true);
            total -= EvaluateMobility(isBlack: false);

            total += EvaluateRookFiles(isBlack: true);
            total -= EvaluateRookFiles(isBlack: false);
        }

        total += EvaluateBishopPair(isBlack: true);
        total -= EvaluateBishopPair(isBlack: false);

        total += EvaluateKingActivityInEndgame(isBlack: true, endgameT);
        total -= EvaluateKingActivityInEndgame(isBlack: false, endgameT);

        if (boardManager.IsKingInCheck(true))
            total += 20;

        if (boardManager.IsKingInCheck(false))
            total -= 20;

        return total;
    }

    private int EvaluateMobility(bool isBlack)
    {
        int legalMoveCount = 0;

        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                GameObject piece = boardManager.boardPieces[x, y];
                if (piece == null)
                    continue;

                bool sameColor = isBlack ? IsBlack(piece) : IsWhite(piece);
                if (!sameColor)
                    continue;

                if (IsPieceType(piece, ChessPieceType.Pawn) || IsPieceType(piece, ChessPieceType.King))
                    continue;

                for (int tx = 0; tx < BoardSize; tx++)
                {
                    for (int ty = 0; ty < BoardSize; ty++)
                    {
                        if (boardManager.IsRuleValidMove(piece, x, y, tx, ty))
                            legalMoveCount++;
                    }
                }
            }
        }

        return legalMoveCount;
    }

    private int EvaluateBishopPair(bool isBlack)
    {
        int bishops = 0;

        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                GameObject piece = boardManager.boardPieces[x, y];
                if (!IsPieceType(piece, ChessPieceType.Bishop))
                    continue;

                bool sameColor = isBlack ? IsBlack(piece) : IsWhite(piece);
                if (sameColor)
                    bishops++;
            }
        }

        return bishops >= 2 ? 12 : 0;
    }

    private int EvaluateRookFiles(bool isBlack)
    {
        int score = 0;

        for (int x = 0; x < BoardSize; x++)
        {
            for (int y = 0; y < BoardSize; y++)
            {
                GameObject piece = boardManager.boardPieces[x, y];
                if (!IsPieceType(piece, ChessPieceType.Rook))
                    continue;

                bool sameColor = isBlack ? IsBlack(piece) : IsWhite(piece);
                if (!sameColor)
                    continue;

                bool ownPawnOnFile = false;
                bool enemyPawnOnFile = false;

                for (int fy = 0; fy < BoardSize; fy++)
                {
                    GameObject onFile = boardManager.boardPieces[x, fy];
                    if (!IsPieceType(onFile, ChessPieceType.Pawn))
                        continue;

                    bool ownPawn = isBlack ? IsBlack(onFile) : IsWhite(onFile);
                    if (ownPawn)
                        ownPawnOnFile = true;
                    else
                        enemyPawnOnFile = true;
                }

                if (!ownPawnOnFile && !enemyPawnOnFile)
                    score += 8;
                else if (!ownPawnOnFile)
                    score += 4;
            }
        }

        return score;
    }

    private bool HasNonPawnMaterial(bool forWhite)
